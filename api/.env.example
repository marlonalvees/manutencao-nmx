# Mesmo banco Supabase do hub. As tabelas deste sistema ficam no schema "manutencao".
# Connection pooler (usada pela aplicação)
DATABASE_URL=
# Conexão direta / session pooler (usada pelas migrations)
DIRECT_URL=

# O MESMO JWT_SECRET do hub: é com ele que a API confere o token do login
JWT_SECRET=

# Endereços do site liberados no CORS, separados por vírgula e sem espaço
CORS_ORIGINS=https://manutencao.lojanovamix.com.br,http://localhost:5178

PORT=3008
